{
  "name": "kintone-space-writer-extension",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run src",
    "test:browser": "node scripts/browser-check.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "check": "pnpm test && pnpm build && pnpm test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^20.19.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
